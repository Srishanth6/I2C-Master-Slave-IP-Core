read_verilog rtl/i2c_master.v rtl/i2c_slave.v rtl/i2c_apb.v
synth -top i2c_apb -flatten
tee -o logs/synth_apb.log stat
design -reset
read_verilog rtl/i2c_master.v rtl/i2c_slave.v rtl/i2c_apb.v
synth -top i2c_slave -flatten
tee -o logs/synth_slave.log stat
design -reset
read_verilog rtl/i2c_master.v
synth -top i2c_master -flatten
tee -o logs/synth_master.log stat
